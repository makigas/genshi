---
import RootLayout from "./RootLayout.astro";

const RENDITION_LABELS = {
  html: "HTML/CSS",
  svelte: "Svelte",
} as const;

type Rendition = keyof typeof RENDITION_LABELS;

interface Props {
  frontmatter?: {
    title?: string;
    renditions?: Rendition[];
  };
  title?: string;
  renditions?: Rendition[];
}

const { frontmatter, title, renditions } = Astro.props;
const pageTitle = title ?? frontmatter?.title;
const pageRenditions = renditions ?? frontmatter?.renditions ?? [];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, "");
const [, currentRendition, ...pageSegments] = path.split("/");
const pagePath = pageSegments.join("/");
---

<style>
  .pageHeader {
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5rem;
  }

  @media screen and (min-width: 1024px) {
    .pageHeader {
      align-items: center;
      flex-direction: row;
      margin-bottom: 0;
      height: 6rem;
    }
  }

  .pageHeader h1 {
    margin: 0;
  }

  .pageRenditions ul {
    list-style: none;
    margin: 0;
    padding-left: 0;
    display: flex;
    gap: 0.5rem;
  }
  .pageRenditions [aria-current="page"] {
    font-weight: bold;
  }
</style>

<RootLayout title={pageTitle}>
  <header class="pageHeader">
    {pageTitle && <h1>{pageTitle}</h1>}
    {pageRenditions.length > 1 && pagePath && (
      <nav class="pageRenditions" aria-label="API rendition">
        <ul>
          {pageRenditions.map((rendition) => (
            <li>
              <a
                href={base + "/" + rendition + "/" + pagePath + "/"}
                aria-current={rendition === currentRendition ? "page" : undefined}>
                {rendition === currentRendition ? (
                  RENDITION_LABELS[rendition]
                ) : (
                  <small>{RENDITION_LABELS[rendition]}</small>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </header>
  <slot />
</RootLayout>
