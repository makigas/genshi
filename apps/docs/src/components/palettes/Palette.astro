const steps = Array.from({ length: 20 }, (_, index) => index + 1);

const palettes = [
    ["Neutral", "data-neutral"],
    ["Tint", "data-tint"],
    ["Accent", "data-accent"],
    ["Danger", "data-danger"],
    ["Warning", "data-warning"],
    ["Success", "data-success"],
    ["Info", "data-info"],
]
---

<div>
    {palettes.map(([name, data]) => (
      <figure>
          <figcaption>{name} palette</figcaption>
          <div class="palette">
            {steps.map((step) => <div class="row" {...{[data]: step}}></div>)}
          </div>
      </figure>
    ))}
</div>

<style lang="scss">
  @use "./_palette.scss";

  figure {
      margin: 0;
  }

  figcaption {
      text-align: center;
      font-weight: bold;
      margin-bottom: 0.2rem;
  }

  .palette {
      display:   grid;
      grid-auto-flow: column;
      width: 100%;
      height: 4rem;
  }
</style>
