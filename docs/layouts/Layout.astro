---
import "@fontsource/montserrat";
import "@fontsource/montserrat/700.css";
import "../../src/genshi.scss";
import LayoutFooter from "../components/LayoutFooter.astro";
import LayoutNav from "../components/LayoutNav.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/genshi/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Genshi</title>
    <style>
      .logo img {
        max-width: 240px;
        margin-top: 0.5rem;
      }

      @media screen and (min-width: 1024px) {
        .app {
          display: flex;
          gap: 2rem;
          margin-top: 1rem;
          margin-bottom: 1rem;
        }

        .app > header {
          width: 240px;
        }

        .app > main {
          flex: 1;
          margin-bottom: 2rem;
          min-width: 0;
        }
      }
    </style>
  </head>
  <body>
    <div class="GenshiWrapper GenshiWrapper--slim">
      <div class="app">
        <header>
          <a href="/genshi/">
            <picture class="logo">
              <source media="(prefers-color-scheme: dark)" srcset="/genshi/genshi@dark.png" />
              <source media="(prefers-color-scheme: light)" srcset="/genshi/genshi.png" />
              <img alt="Genshi" src="/genshi/genshi.png" />
            </picture>
          </a>
          <LayoutNav />
        </header>
        <main>
          <slot />
        </main>
      </div>
    </div>
    <LayoutFooter />
  </body>
</html>
