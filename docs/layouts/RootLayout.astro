---
import "@fontsource/montserrat";
import "@fontsource/montserrat/700.css";
import "../../src/genshi.scss";
import LayoutFooter from "../components/LayoutFooter.astro";
import LayoutNav from "../components/LayoutNav.astro";
import LayoutHeader from "../components/LayoutHeader.astro";
import socialOpenGraphImage from "../assets/opengraph.png";
import { Image } from "astro:assets";
import { getImage } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

function documentTitle() {
  if (title) {
    return `Genshi — ${title}`;
  } else {
    return "Genshi";
  }
}

function documentDescription() {
  return description || `An atomic design system`;
}

const socialImage = await getImage({
  src: socialOpenGraphImage,
  format: "png",
});

function socialImageUrl() {
  const url = new URL(Astro.url);
  url.pathname = socialImage.src;
  return decodeURIComponent(url.toString());
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/genshi/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{documentTitle()}</title>
    <meta name="description" content={documentDescription()} />
    <link rel="canonical" href={Astro.url} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={documentTitle()} />
    <meta name="twitter:description" content={documentDescription()} />
    <meta name="twitter:image" content={socialImageUrl()} />

    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={documentTitle()} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={documentDescription()} />
    <meta property="og:site_name" content="Genshi" />
    <meta property="og:image" content={socialImageUrl()} />
    <style>
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .app {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 2rem;
        margin-bottom: 2rem;
      }

      @media screen and (min-width: 1024px) {
        .app {
          flex-direction: row;
          gap: 4rem;
        }

        .app-left {
          width: 12rem;
        }

        main {
          flex: 1;
          min-width: 0;
        }
      }
    </style>
  </head>
  <body>
    <div class="GenshiWrapper app">
      <div class="app-left">
        <LayoutHeader />
        <LayoutNav />
      </div>
      <main>
        <slot />
      </main>
    </div>
    <LayoutFooter />
  </body>
</html>
