---
import "@fontsource/montserrat";
import "@fontsource/montserrat/700.css";
import "../../src/genshi.scss";
import LayoutFooter from "../components/LayoutFooter.astro";
import LayoutNav from "../components/LayoutNav.astro";
import LayoutHeader from "../components/LayoutHeader.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;

function documentTitle() {
  if (title) {
    return `Genshi — ${title}`;
  } else {
    return "Genshi";
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/genshi/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{documentTitle()}</title>
    <style>
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .app {
        margin-top: 2rem;
        margin-bottom: 2rem;
      }

      @media screen and (min-width: 1024px) {
        .app {
          display: flex;
          gap: 4rem;
        }

        .app-left {
          width: 15rem;
        }

        .app main {
          flex: 1;
          min-width: 0;
        }
      }
    </style>
  </head>
  <body>
    <div class="GenshiWrapper GenshiWrapper--slim">
      <div class="app">
        <div class="app-left">
          <LayoutHeader />
          <LayoutNav />
        </div>
        <main>
          <slot />
        </main>
      </div>
    </div>
    <LayoutFooter />
  </body>
</html>
