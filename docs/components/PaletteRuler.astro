---
const values = Array(9)
  .fill(0)
  .map((_, i) => (i + 1) * 100);
---

<style>
  @media screen and (max-width: 767px) {
    .GenshiCols {
      display: none;
    }
  }
  .node {
    text-align: center;
  }
</style>

<div class="GenshiCols GenshiCols--gapless">
  <div></div>
  {values.map((val) => <div class="node">{val}</div>)}
</div>
