        </li>
      </ul>
    </li>
    <li>
      <strong>Layout</strong>
      <ul>
        <li><a href="/genshi/layout/cols/">Cols</a></li>
        <li><a href="/genshi/layout/stack/">Stack</a></li>
        <li><a href="/genshi/layout/wrapper/">Wrapper</a></li>
      </ul>
    </li>
    <li>
      <strong>Form</strong>
      <ul>
        <li><a href="/genshi/form/button/">Button</a></li>
        <li><a href="/genshi/form/text-field/">Text Field</a></li>
        <li><a href="/genshi/form/textarea/">Textarea</a></li>
        <li><a href="/genshi/form/select/">Select</a></li>
        <li><a href="/genshi/form/checkbox/">Checkbox</a></li>
        <li><a href="/genshi/form/radio/">Radio</a></li>
