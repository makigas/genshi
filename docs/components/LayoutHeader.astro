---
import genshiLogoLight from "../assets/genshi.png";
import genshiLogoDark from "../assets/genshi@dark.png";
import { Image } from "astro:assets";
---

<style>
  header {
    text-align: center;
    margin-bottom: 1rem;
  }
  .logo img {
    max-width: 100%;
    height: 6rem;
    object-fit: contain;
  }
</style>

<header>
  <a href="/genshi/">
    <picture class="logo">
      <source media="(prefers-color-scheme: dark)" srcset={genshiLogoDark.src} />
      <source media="(prefers-color-scheme: light)" srcset={genshiLogoLight.src} />
      <Image src={genshiLogoLight} alt="Genshi" />
    </picture>
  </a>
</header>
