---
import PaletteRow from "./PaletteRow.astro";
import PaletteRuler from "./PaletteRuler.astro";

interface Props {
  palettes: string[];
}

const { palettes } = Astro.props;
---

<style>
  @media screen and (max-width: 767px) {
    .stack {
      display: grid;
      grid-template-columns: repeat(3, auto);
      gap: 1rem;
    }
  }
</style>

<div class="GenshiStack GenshiStack--gapless GenshiStack--v stack">
  <PaletteRuler />
  {palettes.map((pal) => <PaletteRow key={pal} name={pal} />)}
</div>
