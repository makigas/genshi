{
  "name": "genshi-workspace",
  "scripts": {
    "fmt": "prettier -w . && pnpm -r run fmt",
    "fmt:check": "prettier -c . && pnpm -r run fmt:check",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "docs": "mise run docs",
    "docs:dev": "mise run docs:dev",
    "docs:preview": "mise run docs:preview",
    "clean": "pnpm -r run clean",
    "build": "pnpm -r run build",
    "check": "pnpm -r --if-present run check",
    "test": "pnpm -r --if-present run test"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@fontsource/montserrat": "^5.3.0",
    "astro": "^7.4.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "rimraf": "^6.1.3",
    "sass": "^1.107.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "stylelint-prettier": "^5.0.3"
  },
  "packageManager": "pnpm@12.15.0",
  "private": true
}
