{
  "name": "genshi-workspace",
  "scripts": {
    "dist": "pnpm --filter @makigas/genshi run dist",
    "dist:min": "pnpm --filter @makigas/genshi run dist:min",
    "fmt": "prettier -w .",
    "fmt:check": "prettier -c .",
    "lint": "stylelint packages/css/src",
    "lint:fix": "stylelint packages/css/src --fix",
    "docs": "mise run docs",
    "docs:dev": "mise run docs:dev",
    "docs:preview": "mise run docs:preview",
    "clean": "rimraf packages/css/dist apps/docs/www apps/docs/.astro"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "sass": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "stylelint-prettier": "^5.0.3"
  },
  "packageManager": "pnpm@12.15.0",
  "private": true
}
