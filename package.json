{
  "name": "@makigas/genshi",
  "version": "1.0.0-alpha.1",
  "description": "An atomic design system",
  "main": "dist/genshi.css",
  "style": "dist/genshi.css",
  "scripts": {
    "dist": "sass src/genshi.scss dist/genshi.css",
    "dist:min": "sass src/genshi.scss dist/genshi.min.css --style=compressed",
    "fmt": "prettier -w .",
    "fmt:check": "prettier -c .",
    "lint": "stylelint src",
    "lint:fix": "stylelint src --fix",
    "docs": "astro build",
    "docs:dev": "astro dev",
    "docs:preview": "astro preview",
    "clean": "rimraf dist www .astro",
    "prepack": "run-s fmt:check lint dist dist:min"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makigas/genshi.git"
  },
  "files": [
    "dist/*.{css,map}",
    "docs/assets/genshi*.png"
  ],
  "keywords": [
    "genshi",
    "design",
    "css",
    "components"
  ],
  "author": {
    "name": "Dani Rodríguez",
    "email": "dani@danirod.es"
  },
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/makigas/genshi/issues"
  },
  "homepage": "https://github.com/makigas/genshi#readme",
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@fontsource/montserrat": "^5.3.0",
    "astro": "^7.4.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "sass": "^1.106.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "stylelint-prettier": "^5.0.3"
  },
  "packageManager": "pnpm@12.15.0"
}
